<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <layer-list>
            <item android:left="4dp" android:top="4dp"><shape android:shape="rectangle"><solid android:color="@color/comic_ink" /><corners android:radius="6dp" /></shape></item>
            <item android:right="4dp" android:bottom="4dp"><shape android:shape="rectangle"><solid android:color="@color/tertiary" /><corners android:radius="6dp" /><stroke android:width="3dp" android:color="@color/comic_ink" /></shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:left="4dp" android:top="4dp"><shape android:shape="rectangle"><solid android:color="@color/comic_ink" /><corners android:radius="6dp" /></shape></item>
            <item android:right="4dp" android:bottom="4dp"><shape android:shape="rectangle"><solid android:color="@color/surface" /><corners android:radius="6dp" /><stroke android:width="3dp" android:color="@color/comic_ink" /></shape></item>
        </layer-list>
    </item>
</selector>
